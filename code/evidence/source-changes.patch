+/* Address order makes adjacent-block coalescing independent of fit policy. */
+static void insert_and_merge(struct Page *base, size_t n) {
+    list_entry_t *le = list_next(&free_list);
+    while (le != &free_list && le2page(le, page_link) < base) {
+        le = list_next(le);
+    }
+    base->property = n;
+    SetPageProperty(base);
+    list_add_before(le, &base->page_link);
+    list_entry_t *prev = list_prev(&base->page_link);
+    if (prev != &free_list) {
+        struct Page *p = le2page(prev, page_link);
+        assert(p + p->property <= base);
+        if (p + p->property == base) {
+            p->property += base->property;
+            ClearPageProperty(base);
+            base->property = 0;
+            list_del(&base->page_link);
+            base = p;
+        }
+    }
+    le = list_next(&base->page_link);
+    if (le != &free_list) {
+        struct Page *p = le2page(le, page_link);
+        assert(base + base->property <= p);
+        if (base + base->property == p) {
+            base->property += p->property;
+            ClearPageProperty(p);
+            p->property = 0;
+            list_del(&p->page_link);
+        }
+    }
+}
+
+static void best_fit_init_memmap(struct Page *base, size_t n) {
+    assert(n > 0);
+    for (struct Page *p = base; p < base + n; ++p) {
+        assert(PageReserved(p));
+        p->flags = p->property = 0;
+        set_page_ref(p, 0);
+    }
+    nr_free += n;
+    insert_and_merge(base, n);
+}
+
+static struct Page *best_fit_alloc_pages(size_t n) {
+    assert(n > 0);
+    if (n > nr_free) {
+        return NULL;
+    }
+    struct Page *best = NULL;
+    for (list_entry_t *le = list_next(&free_list); le != &free_list;
+         le = list_next(le)) {
+        struct Page *p = le2page(le, page_link);
+        if (p->property >= n && (best == NULL || p->property < best->property)) {
+            best = p;
+            if (p->property == n) {
+                break;
+            }
+        }
+    }
+    if (best != NULL) {
+        size_t remain = best->property - n;
+        list_entry_t *prev = list_prev(&best->page_link);
+        list_del(&best->page_link);
+        ClearPageProperty(best);
+        best->property = 0;
+        if (remain != 0) {
+            struct Page *rest = best + n;
+            rest->property = remain;
+            SetPageProperty(rest);
+            list_add(prev, &rest->page_link);
+        }
+        nr_free -= n;
+    }
+    return best;
+}
+
+static void best_fit_free_pages(struct Page *base, size_t n) {
+    assert(n > 0);
