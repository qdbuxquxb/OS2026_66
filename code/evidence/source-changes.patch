+        assert(!PageReserved(p) && !PageProperty(p));
+        p->flags = p->property = 0;
+        set_page_ref(p, 0);
+    }
+    nr_free += n;
+    insert_and_merge(base, n);
+}
+
+static size_t best_fit_nr_free_pages(void) { return nr_free; }
